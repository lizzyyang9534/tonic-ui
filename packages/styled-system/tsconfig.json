{
  "compilerOptions": {
    "allowJs": true,
    "declaration": true,
    "emitDeclarationOnly": false,
    "esModuleInterop": true,
    "target": "ES2021",
    "lib": ["es2022"],
    "moduleResolution": "node",
    "strict": false,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "outDir": "dist/types",
    "rootDir": "src"
  },
  "include": ["src/**/*"]
}
